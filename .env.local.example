# ---------------------------------------------------------------------------
# Supabase (new API key format) — Dashboard → Project Settings → API Keys
# ---------------------------------------------------------------------------
# Public: embedded in browser bundles. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# SERVER ONLY — never prefix these with NEXT_PUBLIC_ (the build fails if you do).
# The secret key bypasses RLS. It is used only by /api/admin/users (create users,
# list emails) and /api/goods (auto-create consignor/consignee records).
SUPABASE_SECRET_KEY=sb_secret_your-key
# Optional server-side URL for the admin client; defaults to NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co

# Legacy names (still accepted as a fallback during migration — remove when done):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=       -> SUPABASE_SECRET_KEY

# Show "demo account" shortcuts on the login page (they only prefill an email;
# a real password is still required). Keep "false" in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# Application Settings (currently not read by the code; values are hard-coded)
NEXT_PUBLIC_APP_NAME="Shree Satguru Transport"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_LOCALE="en-IN"
